[Unit]
Description=mysql-honeypot-rs — lightweight MySQL honeypot
Documentation=https://github.com/HELPMEEADICE/mysql-honeypot-rs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mysql-honeypot
Group=mysql-honeypot

# Everything the service creates (honeypot.db, -wal and -shm) is owner-only, so
# captured credentials and SQL never leak to another local account.
UMask=0077

# The working directory holds honeypot.db unless sqlite_path is absolute.
WorkingDirectory=/var/lib/mysql-honeypot
ExecStart=/usr/local/bin/mysql-honeypot-rs --config /etc/mysql-honeypot/config.toml

Restart=always
RestartSec=3s

# SIGTERM lets the listener stop accepting, close live sessions and flush the
# log queue before the process exits.
KillSignal=SIGTERM
TimeoutStopSec=20s

# ---- hardening -----------------------------------------------------------
# Port 3306 is above 1024, so no capabilities are needed at all.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# The SQLite database (and its -wal/-shm siblings) is the only writable path.
# StateDirectory creates exactly that directory under /var/lib and grants the
# process write access to it, so the two settings name the same path.
ReadWritePaths=/var/lib/mysql-honeypot
StateDirectory=mysql-honeypot
StateDirectoryMode=0750

LimitNOFILE=8192
MemoryMax=256M

[Install]
WantedBy=multi-user.target
